{
  "name": "content-intelligence-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node scripts/worker.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "test:e2e": "playwright test tests/e2e/s8-lifecycle.spec.ts tests/e2e/s9-review.spec.ts tests/e2e/s10-notes-next-test.spec.ts tests/e2e/processing-lifecycle.spec.ts tests/e2e/workspace-shell.spec.ts",
    "test:e2e:s9": "playwright test tests/e2e/s9-review.spec.ts",
    "test:e2e:s10": "playwright test tests/e2e/s10-notes-next-test.spec.ts",
    "test:e2e:ui": "playwright test --ui tests/e2e/s8-lifecycle.spec.ts",
    "test:e2e:staging": "CIC_E2E_STAGING_URL=${CIC_E2E_STAGING_URL:-http://127.0.0.1:3120} playwright test tests/e2e/staging-smoke.spec.ts"
  },
  "dependencies": {
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
